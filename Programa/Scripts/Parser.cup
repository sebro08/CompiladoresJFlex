:}
| LOCAL tipo:t IDENTIFICADOR:idToken Arreglo:arr ASIGNAR BloqueArreglo:blo ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "local", sid);
    Nodo arbol = new Nodo("DECL_LOCAL_ARREGLO_ASIG");
    Nodo nid = new Nodo(idToken.toString());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(arr);
    arbol.addHijo(new Nodo("="));
    arbol.addHijo(blo);
    String tipoA = t.getTipo();
    String tipoB = blo.getTipo();
    if ("error".equals(tipoB) || "error".equals(tipoA)) {
        nid.setTipo("error");
        arbol.setTipo("error");
    }
    else if (tipoA != tipoB) {
        System.err.println( "Error semántico en la línea " + sid.left + ": arreglo '" + idToken.toString() + "' es de tipo " + tipoA + " pero el bloque contiene " + tipoB);
        nid.setTipo("error");
        arbol.setTipo("error");
    }
    else {
        nid.setTipo(tipoA);
        arbol.setTipo(tipoA);
    }
    RESULT = arbol;
:};

asignacion ::= IDENTIFICADOR:idToken ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("ASIGNACION");
    Nodo idN = new Nodo(idToken.toString());
    TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());

    String tipoA = (info != null) ? info.tipo : "error";
    String tipoB = e.getTipo();
    idN.setTipo(tipoA);
    arbol.addHijo(idN);
    arbol.addHijo(e);
    if (tipoA != "error" || tipoB != "error") {
        arbol.setTipo("error");
    }
    else if (tipoA.equals(tipoB) || (tipoA == "float" && tipoB == "int")) {
        arbol.setTipo(tipoA);
    }
    else {
        System.err.println(
            "Error semántico en la línea " + sid.left + ": '" + idToken.toString() + "' es de tipo " + tipoA +" y se le asignó un " + tipoB);
        arbol.setTipo("error");
        idN.setTipo("error");
    }
    RESULT = arbol;
:};

llamada ::= IDENTIFICADOR:idToken PARENTESIS_A Parametros_LLamada:a PARENTESIS_B {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);

    TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());

    Nodo arbol = new Nodo("llamada");

    Nodo idN = new Nodo(idToken.toString());
    if (info != null) {
        idN.setTipo(info.tipo);
    }
    else {
        idN.setTipo("error");
    }

    arbol.addHijo(idN);
    arbol.addHijo(a);

    if (info != null) {
        if (!"funcion".equals(info.categoria)) {
            System.err.println(
                "Error Semantico en la linea "+ sid.left + ": "+ idToken.toString() + " no es una función");
            arbol.setTipo("error");
        } 
        else {
            List<String> esperados = tab.getFunctionParams(idToken.toString());
            List<String> enviados = new ArrayList<>();
            String sig = a.getTipo();


            if (sig == null) sig = "";
        if ("error".equals(sig)) {
            arbol.setTipo("error");
        } else {
            if (!sig.equals("")) {
                for (String s : sig.split(",")) enviados.add(s.trim());
            }
            if (esperados == null){
                esperados = new ArrayList<>();
            }
            if (enviados.size() != esperados.size()) {
                System.err.println("Error Semantico en la linea "+ sid.left + ": la cantidad de paramtros no son iguales "+ idToken.toString());
                arbol.setTipo("error");
            } else {
                boolean falla = true;

                for (int i = 0; i < esperados.size(); i++) {
                    String te = esperados.get(i);
                    String ta = enviados.get(i);

                    if ("error"== te || "error"== ta || te == null || ta == null) {
                        falla = false;
                        break;
                    }

                    if (!(te.equals(ta) || (te.equals("float") && ta.equals("int")))) {
                        falla = false;
                        break;
                    }
                }
                if (!falla) {
                    System.err.println("Error Semantico en la linea " + sid.left +
                        ": tipos de parámetros incompatibles en " + idToken.toString());
                    arbol.setTipo("error");
                } else {
                    arbol.setTipo(info.tipo);
                }
            }
        }
        }
    } else {
        arbol.setTipo("error");
    }


    RESULT = arbol;
:};
Parametros_LLamada ::= /* vacio */ {: 
        Nodo arbol = new Nodo("argumentos_vacio");
        arbol.setTipo("");
        RESULT = arbol;
    :}
    | para_llamada:a {: 
        RESULT = a; 
    :}
;


para_llamada ::= expr:e {:
    Nodo arbol = new Nodo("argumentos");
    arbol.addHijo(e);
    String tipoA = e.getTipo();
    arbol.setTipo(tipoA);
    RESULT = arbol;
:}
| para_llamada:para COMA expr:e {:
    Nodo arbol = para;
    arbol.addHijo(new Nodo(","));
    arbol.addHijo(e);
    String base = arbol.getTipo();
    String tipoA = e.getTipo();
    if ("error".equals(base) || "error".equals(tipoA) || tipoA == null) {
        arbol.setTipo("error");
    } else if (base == null || base.equals("")) {
        arbol.setTipo(tipoA);
    } else {
        arbol.setTipo(base + "," + tipoA);
    }
    RESULT = arbol;
:};




sentencia ::= creacion:c            {:  RESULT = c; :}
            | asignacion:a          {:  RESULT = a; :}
            | expr:e ENDL           {:  RESULT = e; :}
            |DECIDE OF condiciones:cnds else_opcional:els END DECIDE ENDL {:
                Nodo arbol = new Nodo("DECIDE");
                arbol.addHijo(cnds);
                if (els != null) arbol.addHijo(els);

                if ("error".equals(cnds.getTipo())) arbol.setTipo("error");

                RESULT = arbol;
            :}
            |LOOP sentencias:s EXIT WHEN expr:e ENDL END LOOP ENDL {:
                Nodo arbol = new Nodo("LOOP");
                arbol.addHijo(s);

                Nodo exitWhen = new Nodo("EXIT_WHEN");
                exitWhen.addHijo(e);
                arbol.addHijo(exitWhen);

                String tipoE = e.getTipo();

                if ("error".equals(tipoE)) {
                    arbol.setTipo("error");
                    exitWhen.setTipo("error");
                }
                else if (!"boolean".equals(tipoE)) {
                    System.out.println("Error Semantico en la linea "+ eleft + ": EXIT WHEN debe ser boolean y se recibió " + tipoE);
                    arbol.setTipo("error");
                    exitWhen.setTipo("error");
                }
                else {
                    exitWhen.setTipo("boolean");
                }

                RESULT = arbol;
            :}

            |FOR PARENTESIS_A asignacion:a expr:cond ENDL expr:inc PARENTESIS_B bloque:b {:
                Nodo arbol = new Nodo("FOR");
                arbol.addHijo(a);
                arbol.addHijo(cond);
                arbol.addHijo(inc);
                arbol.addHijo(b);

                String tipoCond = cond.getTipo();
                String tipoInc  = inc.getTipo();
                String tipoA    = a.getTipo();
                if ("error".equals(tipoA) || "error".equals(tipoCond) || "error".equals(tipoInc)) {
                    arbol.setTipo("error");
                }
                else {
                    if (!"boolean".equals(tipoCond)) {
                        System.out.println("Error Semantico en la linea "+ condleft + ": la condición del FOR debe ser boolean y se recibió " + tipoCond);
                        arbol.setTipo("error");
                    }
                    else if (!("int".equals(tipoInc) || "float".equals(tipoInc))) {
                        System.out.println("Error Semantico en la linea "+ incleft + ": el incremento del FOR debe ser int o float y se recibió " + tipoInc);
                        arbol.setTipo("error");
                    }
                }

                RESULT = arbol;
            :}

            |FOR PARENTESIS_A creacion:c expr:cond ENDL expr:inc PARENTESIS_B bloque:b {:
                Nodo arbol = new Nodo("FOR");
                arbol.addHijo(c);
                arbol.addHijo(cond);
                arbol.addHijo(inc);
                arbol.addHijo(b);
                String tipoCond = cond.getTipo();
                String tipoInc  = inc.getTipo();
                String tipoC    = c.getTipo();
                if ("error".equals(tipoC) || "error".equals(tipoCond) || "error".equals(tipoInc)) {
                    arbol.setTipo("error");
                }
                else {
                    if (!"boolean".equals(tipoCond)) {
                        System.out.println("Error Semantico en la linea "+ condleft + ": la condición del FOR debe ser boolean y se recibió " + tipoCond);
                        arbol.setTipo("error");
                    }
                    else if (!("int".equals(tipoInc) || "float".equals(tipoInc))) {
                        System.out.println("Error Semantico en la linea "+ incleft + ": el incremento del FOR debe ser int o float y se recibió " + tipoInc);
                        arbol.setTipo("error");
                    }
                }

                RESULT = arbol;
            :}

            | RETURN expr:e ENDL    {:  Nodo arbol = new Nodo("RETURN");
                                        arbol.addHijo(e);
                                        String tipoa = e.getTipo();
                                        if (tipoF == "main"){
                                            arbol.setTipo("main");
                                        }
                                        else if (tipoF == tipoa){
                                            arbol.setTipo(tipoa);
                                        }
                                        else if (tipoa == "error"){
                                            arbol.setTipo("error");
                                        }
                                        else {
                                            System.out.println("Error Semantico en la linea "+ eleft + ": la funcion retorna un tipo " + tipoF + " y esta retornando un " + tipoa );
                                            arbol.setTipo("error");
                                        }
                                        tipoF = "";
                                        RESULT = arbol;:}
            | BREAK ENDL            {:  RESULT = new Nodo("BREAK");:}
            | SHOW expr:e ENDL      {:  Nodo arbol = new Nodo("SHOW");
                                        arbol.addHijo(e);
                                        RESULT = arbol;:}
            | GET expr:e ENDL       {:  Nodo arbol = new Nodo("GET");
                                        arbol.addHijo(e);
                                        RESULT = arbol;:}
            | error ENDL            {:  RESULT = new Nodo("ERROR_STMT");:}
            | modificar_arry:ma {: RESULT = ma; :}
            ;

//para poder tener varias condiciones completas
condiciones ::= condicion:con {:
    Nodo arbol = con;

    if ("error".equals(con.getTipo())) arbol.setTipo("error");
    else arbol.setTipo("boolean");

    RESULT = arbol;
:}
| condiciones:cons condicion:con {:
    Nodo arbol = cons;
    arbol.addHijo(con);

    if ("error".equals(cons.getTipo()) || "error".equals(con.getTipo())) arbol.setTipo("error");
    else arbol.setTipo("boolean");

    RESULT = arbol;
:};


condicion ::= expr:exp FLECHA bloque:blo {:
    Nodo arbol = new Nodo("condicion");
    arbol.addHijo(exp);
    arbol.addHijo(new Nodo("->"));
    arbol.addHijo(blo);

    String tipoExp = exp.getTipo();

    if ("error".equals(tipoExp)) {
        arbol.setTipo("error");
    }
    else if (!"boolean".equals(tipoExp)) {
        System.out.println("Error Semantico en la linea "+ expleft + ": la condición del DECIDE debe ser boolean y se recibió " + tipoExp);
        arbol.setTipo("error");
    }
    else {
        arbol.setTipo("boolean");
    }

    RESULT = arbol;
:};

//se pide el else opcional, por lo que se pone /* vacio */
else_opcional ::= /* vacio */| ELSE FLECHA bloque:blo {:
    Nodo arbol = new Nodo("ELSE");
    arbol.addHijo(new Nodo("->"));
    arbol.addHijo(blo);
    RESULT = arbol;
:}
;


sentencias ::= /* vacio */ {:
    RESULT = new Nodo("SENTENCIAS");
:}
| sentencias:ss sentencia:st {:
    Nodo arbol = ss;
    if (st == null) st = new Nodo("SENTENCIA_NULL");
    arbol.addHijo(st);
    RESULT = arbol;
:};

bloque ::= BLOQUE_A sentencias:s BLOQUE_C {:
    Nodo arbol = new Nodo("BLOQUE");
    arbol.addHijo(s);
    RESULT = arbol;
:};


expr ::= expr:a SUMA expr:b             {: Nodo arbol=new Nodo("+"); arbol.addHijo(a); arbol.addHijo(b);
    String tipoA = a.getTipo();
    String tipoB = b.getTipo();

    boolean numA = tipoA == "int" || tipoA == "float";
    boolean numB = tipoB == "int" || tipoB == "float";

   if (tipoA == "error" || tipoB == "error") {
        arbol.setTipo("error");
    }
    else if   (!numA || !numB) {
        System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " + " + b.getTipo() + ")");
        arbol.setTipo("error");
    }
    else {
        if (tipoA == "float" || tipoB == "float") {
            arbol.setTipo("float");
        }
        else{
            arbol.setTipo("int");
        }
    }
    RESULT = arbol;
:}
       | expr:a RESTA expr:b            {: Nodo arbol=new Nodo("-"); arbol.addHijo(a); arbol.addHijo(b); 
    String tipoA = a.getTipo();
    String tipoB = b.getTipo();

    boolean numA = tipoA == "int" || tipoA == "float";
    boolean numB = tipoB == "int" || tipoB == "float";

    if (tipoA == "error" || tipoB == "error") {
        arbol.setTipo("error");
    }
    else if   (!numA || !numB) {
    System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " - " + b.getTipo() + ")");
    arbol.setTipo("error");
    }
    else {
        if (tipoA == "float" || tipoB == "float") {
            arbol.setTipo("float");
        }
        else{
            arbol.setTipo("int");
        }
    }

    RESULT = arbol;:}
       | expr:a MULTIPLICACION expr:b   {: Nodo arbol=new Nodo("*"); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";

        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " * " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            if (tipoA == "float" || tipoB == "float") {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a DIVISION expr:b         {: Nodo arbol=new Nodo("/"); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if   (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " / " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            if (tipoA == "float" || tipoB == "float") {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}

       | expr:a DIVISION_ENTERA expr:b  {: Nodo arbol=new Nodo("//"); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";

        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " // " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            if (tipoA == "float" || tipoB == "float") {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a MODULO expr:b           {: Nodo arbol=new Nodo("%"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " % " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            if (tipoA == "float" || tipoB == "float") {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a POTENCIA expr:b         {: Nodo arbol=new Nodo("^"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol;
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if   (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " ^ " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            if (tipoA == "float" || tipoB == "float") {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a MAYOR expr:b            {: Nodo arbol=new Nodo(">"); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " > " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a MENOR expr:b            {: Nodo arbol=new Nodo("<"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";
        
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " < " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a IGUAL expr:b            {: Nodo arbol=new Nodo("=="); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if (tipoA != tipoB) {
            System.out.println(
                "Error Semantico en la linea " + aleft +": comparación con tipos incompatibles (" + tipoA + " == " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT = arbol;:}
    
       | expr:a DIFERENTE expr:b        {: Nodo arbol=new Nodo("!="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol;
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if (tipoA != tipoB) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": comparación con tipos incompatibles (" +
                tipoA + " != " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT = arbol;:}
       | expr:a MAYOR_IGUAL expr:b      {: Nodo arbol=new Nodo(">="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";
        
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " >= " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a MENOR_IGUAL expr:b      {: Nodo arbol=new Nodo("<="); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA == "int" || tipoA == "float";
        boolean numB = tipoB == "int" || tipoB == "float";
        
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " <=" + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a AND expr:b              {: Nodo arbol=new Nodo("@"); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if (!tipoA.equals("boolean") || !tipoB.equals("boolean")) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": AND utiliza boolean (" + tipoA + " @ " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT=arbol; :}
       | expr:a OR expr:b               {: Nodo arbol=new Nodo("~"); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();
        if (tipoA == "error" || tipoB == "error") {
            arbol.setTipo("error");
        }
        else if (!tipoA.equals("boolean") || !tipoB.equals("boolean")) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": OR utiliza boolean (" + tipoA + " ~ " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT=arbol; :}
       | NOT expr:a                     {: Nodo arbol= new Nodo("Σ"); arbol.addHijo(a);
        String tipoA = a.getTipo();
        if (tipoA == "error" ) {
            arbol.setTipo("error");
        }
        else if (!tipoA.equals("boolean")) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": Not utiliza boolean (  Σ " + tipoA + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT=arbol; :}
       | AUMENTO IDENTIFICADOR:idToken {: Nodo arbol = new Nodo("++");
                                            Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
                                            tab.use(idToken.toString(), sid);
                                            Nodo idN = new Nodo(idToken.toString());
                                            TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
                                            if (info != null) {
                                                idN.setTipo(info.tipo);
                                                if (!info.tipo.equals("int") && !info.tipo.equals("float")) {
                                                    System.err.println(
                                                        "Error semántico: '++' solo se permite en int/float, pero '" +idToken.toString() + "' es " + info.tipo );
                                                    arbol.setTipo("error");
                                                } else {
                                                    arbol.setTipo(info.tipo);
                                                }
                                            } else {
                                                idN.setTipo("error");
                                                arbol.setTipo("error");
                                            }

                                            arbol.addHijo(idN);
                                           RESULT = arbol;:}
       | DISMINUCION IDENTIFICADOR:idToken {: Nodo arbol = new Nodo("--");

                                            Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
                                            tab.use(idToken.toString(), sid);
                                            Nodo idN = new Nodo(idToken.toString());
                                            TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
                                            if (info != null) {
                                                idN.setTipo(info.tipo);
                                                if (!info.tipo.equals("int") && !info.tipo.equals("float")) {
                                                    System.err.println("Error semántico: '--' solo se permite en int/float, pero '" +idToken.toString() + "' es " + info.tipo );
                                                    arbol.setTipo("error");
                                                } else {
                                                    arbol.setTipo(info.tipo);
                                                }
                                            } else {
                                                idN.setTipo("error");
                                                arbol.setTipo("error");
                                            }
                                            arbol.addHijo(idN);
                                            RESULT = arbol;:}

       | PARENTESIS_A expr:a PARENTESIS_B {: Nodo arbol = new Nodo("¿?"); arbol.addHijo(a); arbol.setTipo(a.getTipo()); RESULT = arbol; :}
       | literal:l                      {:  RESULT = l; :}
       | IDENTIFICADOR:idToken          {: Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken); tab.use(idToken.toString(), sid); 
        Nodo arbol = new Nodo(idToken.toString());
        TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
        if (info != null){
            arbol.setTipo(info.tipo);
        } 
        else {
            
            arbol.setTipo("error");  
        } 
        RESULT = arbol;
       :}  
       | llamada:call                   {:  RESULT = call; :} 
       | Aceder_arry:aa {: RESULT = aa; :}   
       ;
Arreglo ::=LLAVE_A INT_LITERAL:a LLAVE_B LLAVE_A INT_LITERAL:b LLAVE_B {:
    Nodo arbol = new Nodo("arreglo");
    arbol.addHijo(new Nodo("[]"));
    arbol.addHijo(new Nodo(a.toString()));
    arbol.addHijo(new Nodo("[]"));
    arbol.addHijo(new Nodo(b.toString()));
    RESULT = arbol;
:};

Aceder_arry ::= IDENTIFICADOR:idToken LLAVE_A expr:i LLAVE_B LLAVE_A expr:j LLAVE_B {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("Filas Columnas");
    TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
    arbol.addHijo(new Nodo(idToken.toString()));
    Nodo a = new Nodo("[]");
    a.addHijo(i);
    Nodo b = new Nodo("[]");
    b.addHijo(j);
    arbol.addHijo(a);
    arbol.addHijo(b);

    String tipoA = i.getTipo();
    String tipoB = j.getTipo();

    if (info == null) {
        arbol.setTipo("error");
    }
    else {
        if (tipoA != "int" || tipoB != "int" ){
            System.err.println("Error semántico en la linea " + ileft + ": los indices del arreglo debe ser enteros");
            arbol.setTipo("error");
        }
        else if (info.tipo != "int" && info.tipo != "char"){
            System.err.println("Error semántico en la línea " + sid.left + ": solo se permite acceder a arreglos int o char");
            arbol.setTipo("error");
        }
        else{
            arbol.setTipo(info.tipo);
        }
    }
    RESULT = arbol;
:};
modificar_arry ::=  IDENTIFICADOR:idToken LLAVE_A expr:i LLAVE_B LLAVE_A expr:j LLAVE_B ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("filas columnas");
    TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
    arbol.addHijo(new Nodo(idToken.toString()));
    Nodo a = new Nodo("[]");
    a.addHijo(i);
    Nodo b = new Nodo("[]");
    b.addHijo(j);
    arbol.addHijo(a);
    arbol.addHijo(b);
    arbol.addHijo(e);

    String tipoA = i.getTipo();
    String tipoB = j.getTipo();
    String tipoc = e.getTipo();

    if (info == null) {
        arbol.setTipo("error");
    }
    else {
        if (tipoA != "int" || tipoB != "int" ){
            System.err.println("Error semántico en la linea " + ileft + ": los indices del arreglo debe ser enteros");
            arbol.setTipo("error");
        }
        else if (info.tipo != "int" && info.tipo != "char"){
            System.err.println("Error semántico en la línea " + sid.left + ": el identiciador es tipo "+info.tipo+" y los arreglo solo son int o char");
            arbol.setTipo("error");
        }
        else if (info.tipo != tipoc) {
            System.err.println("Error semántico en la línea " + sid.left + ": el arreglo es tipo "+info.tipo +" y el elemento "+ tipoc);
            arbol.setTipo("error");
        }
        else{
            arbol.setTipo(info.tipo);
        }
    }
    RESULT = arbol;
:};


BloqueArreglo ::= BLOQUE_A Columnas:col BLOQUE_C {:
    Nodo arbol = new Nodo("BloqueArreglo");
    arbol.addHijo(new Nodo("¡!"));
    arbol.addHijo(col);
    String tipoA = col.getTipo();
    if (tipoA == "error"){
        arbol.setTipo("error");
    }
    else{
        arbol.setTipo(tipoA);
    }
    RESULT = arbol;
:};

Columnas ::= Columnas:col COMA filas:fil {:
    Nodo arbol = col;
    arbol.addHijo(new Nodo(","));
    arbol.addHijo(fil);

    String tipoA = col.getTipo();
    String tipoB = fil.getTipo();

    if ("error".equals(tipoA) || "error".equals(tipoB)) {
        arbol.setTipo("error");
    }
    else {
        if (!tipoA.equals(tipoB)) {
            System.err.println("Error semántico en la línea " + filleft + ": la fila 1 es de tipo " + tipoA + " y la segunda es de tipo " + tipoB);
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo(tipoA);
        }
    }

    RESULT = arbol;
:}
| filas:fil {:
    Nodo arbol = new Nodo("Columnas");
    arbol.addHijo(new Nodo("¡!"));
    arbol.addHijo(fil);

    String tipoA = fil.getTipo();
    if ("error".equals(tipoA)) {
        arbol.setTipo("error");
    }
    else {
        arbol.setTipo(tipoA);
    }

    RESULT = arbol;
:}
;

filas ::= BLOQUE_A L_elementos:lista BLOQUE_C {:
    Nodo arbol = new Nodo("fila");
    arbol.addHijo(new Nodo("¡!"));
    arbol.addHijo(lista);
    String tipoA = lista.getTipo();
    if (tipoA == "error"){
        arbol.setTipo("error");
    }
    else{
        arbol.setTipo(tipoA);
    }

    RESULT = arbol;
:};


L_elementos ::= L_elementos:lista COMA literal:li {:
        Nodo arbol = lista; 
        arbol.addHijo(new Nodo(","));
        arbol.addHijo(li);

        String tipoA = lista.getTipo();
        String tipoB = li.getTipo();
        if (tipoA=="error"){
            arbol.setTipo("error");
        }
         else if (tipoA == null || tipoA.equals("")) {
            arbol.setTipo(tipoB);
         }
         else {
            if (tipoA != tipoB){ 
                System.err.println( "Error semántico en la línea " + lileft + ": el arreglo no puedce mesclar tipo");
                arbol.setTipo("error");
            }
         }
        RESULT = arbol;:}     

