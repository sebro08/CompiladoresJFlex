import java_cup.runtime.*;
import java.util.*;

action code {:
    TablaSimbolos tab = new TablaSimbolos();
:}

parser code {:
    public void syntax_error(Symbol s){
        System.out.println("Error de sintaxis: "+ s.value +" Línea "+(s.left)+" Columna "+(s.right) );
    }
    public void unrecovered_syntax_error(Symbol s) throws Exception {
        Symbol t = getScanner().next_token();
    }
:}

scan with {:
  return getScanner().next_token();
:};

/* ===== terminales ===== */
terminal SUMA;
terminal RESTA;
terminal MULTIPLICACION;
terminal DIVISION;
terminal DIVISION_ENTERA;
terminal MODULO;
terminal POTENCIA;
terminal AUMENTO;
terminal DISMINUCION;
terminal BLOQUE_A;
terminal BLOQUE_C;
terminal PARENTESIS_A;
terminal PARENTESIS_B;
terminal LLAVE_B;
terminal LLAVE_A;
terminal COMA;
terminal FLECHA;
terminal ASIGNAR;
terminal MAYOR;
terminal MENOR;
terminal IGUAL;
terminal DIFERENTE;
terminal MAYOR_IGUAL;
terminal MENOR_IGUAL;   
terminal AND;
terminal OR;
terminal NOT;
terminal WORD;
terminal LOCAL;
terminal GIFT;
terminal NAVIDAD;
terminal COAL;
terminal INT;
terminal FLOAT;
terminal BOOLEAN;
terminal CHAR;
terminal STRING;
terminal DECIDE;
terminal OF;
terminal ELSE;
terminal END;
terminal LOOP;
terminal EXIT;
terminal WHEN;
terminal FOR;
terminal RETURN;
terminal BREAK;
terminal SHOW;
terminal GET;
terminal ENDL;
terminal INT_LITERAL;
terminal FLOAT_LITERAL;
terminal STRING_LITERAL;
terminal CHAR_LITERAL;
terminal BOOLEAN_LITERAL;
terminal IDENTIFICADOR;


/* ===== No terminales ===== */
non terminal Nodo programa;
non terminal Nodo funciones;
non terminal Nodo globales;
non terminal Nodo global;
non terminal Nodo main;
non terminal Nodo funcion;
non terminal Nodo params;
non terminal Nodo tipo;
non terminal Nodo literal;
non terminal Nodo creacion;
non terminal Nodo asignacion;
non terminal Nodo sentencia;
non terminal Nodo condiciones;
non terminal Nodo condicion;
non terminal Nodo else_opcional;
non terminal Nodo sentencias;
non terminal Nodo bloque;
non terminal Nodo expr;
non terminal Nodo Arreglo;
non terminal Nodo BloqueArreglo;
non terminal Nodo itemParams;
non terminal Nodo Columnas;
non terminal Nodo filas;
non terminal Nodo L_elementos;
non terminal Nodo inicio;

/* ===== Precedencias ===== */
precedence left SUMA, RESTA;
precedence left MULTIPLICACION;
precedence left DIVISION;
precedence left DIVISION_ENTERA;
precedence left MODULO;
precedence right POTENCIA;
precedence left OR;
precedence left AND;
precedence nonassoc MAYOR, MENOR, IGUAL, DIFERENTE, MAYOR_IGUAL, MENOR_IGUAL;

start with inicio;

inicio::= programa:p {:
    RESULT = p;
    System.out.println(" Tabla de simbolos global ");
    tab.printGlobalTable();
    System.out.println("\n\n Arbol sintactico:");
    ((Nodo)programa).arbol();
:}

programa ::= globales:g funciones:f main:m {:
    Nodo arbol = new Nodo("PROGRAMA");
    arbol.addHijo(g);
    arbol.addHijo(f);
    arbol.addHijo(m);
    RESULT = arbol;
:}

globales ::= globales:gs global:gl {:
    Nodo arbol = gs;
    arbol.addHijo(gl);
    RESULT = arbol;
:}
| /* vacio */
{:
    RESULT = new Nodo("GLOBALES");
:};

global ::= WORD tipo:t IDENTIFICADOR:idToken ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "global", sid);
    Nodo arbol = new Nodo("GLOBAL");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    RESULT = arbol;
:}
| WORD tipo:t IDENTIFICADOR:idToken ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "global", sid);

    Nodo arbol = new Nodo("GLOBAL_ASIG");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());

    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(e);
    RESULT = arbol;
:};

funciones ::= funciones:fs funcion:f {:
    Nodo arbol = fs;
    arbol.addHijo(f);
    RESULT = arbol;
:}
| /* vacio */
{:
    RESULT = new Nodo("FUNCIONES");
:};

funcion ::= GIFT tipo:t IDENTIFICADOR:idToken {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "funcion", sid);
    tab.openScope("Funcion " + idToken.toString());
:}
params:p
bloque:b
{:
    tab.closeScope();
    Nodo arbol = new Nodo("FUNCION");
    arbol.setTipo(t.getTipo());
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(p);
    arbol.addHijo(b);
    RESULT = arbol;
:};

main ::= COAL NAVIDAD PARENTESIS_A PARENTESIS_B
{: tab.openScope("Main"); :}
bloque:b
{:
    tab.closeScope();
    Nodo arbol = new Nodo("MAIN");
    arbol.addHijo(b);
    RESULT = arbol;
:};

params ::= PARENTESIS_A PARENTESIS_B {:
    Nodo arbol = new Nodo("params");
    arbol.addHijo(new Nodo("¿"));
    arbol.addHijo(new Nodo("?"));
    RESULT = arbol;
:}
| PARENTESIS_A itemParams:it PARENTESIS_B {:
    Nodo arbol = new Nodo("params");
    arbol.addHijo(new Nodo("¿"));
    arbol.addHijo(it);
    arbol.addHijo(new Nodo("?"));
    RESULT = arbol;
:};

itemParams ::= tipo:t IDENTIFICADOR:idToken {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "parametro", sid);
    Nodo arbol = new Nodo("itemParams");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    RESULT = arbol;
:}
| itemParams:it COMA tipo:t IDENTIFICADOR:idToken {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "parametro", sid);
    Nodo arbol = new Nodo("itemParams");
    arbol.addHijo(it);
    arbol.addHijo(new Nodo(","));
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    RESULT = arbol;
:};

tipo ::= INT  {: Nodo result = new Nodo("int");     result.setTipo("int");     RESULT=result; :}
    | FLOAT   {: Nodo result = new Nodo("float");   result.setTipo("float");   RESULT=result; :}
    | STRING  {: Nodo result = new Nodo("string");  result.setTipo("string");  RESULT=result; :}
    | BOOLEAN {: Nodo result = new Nodo("boolean"); result.setTipo("boolean"); RESULT=result; :}
    | CHAR    {: Nodo result = new Nodo("char");    result.setTipo("char");    RESULT=result; :}
;

literal ::= INT_LITERAL:result      {: RESULT = new Nodo(result.toString()); :}
    | FLOAT_LITERAL:result          {: RESULT = new Nodo(result.toString()); :}
    | STRING_LITERAL:result         {: RESULT = new Nodo(result.toString()); :}
    | CHAR_LITERAL:result           {: RESULT = new Nodo(result.toString()); :}
    | BOOLEAN_LITERAL:result        {: RESULT = new Nodo(result.toString()); :}
;
creacion ::= LOCAL tipo IDENTIFICADOR ENDL | LOCAL tipo IDENTIFICADOR ASIGNAR expr ENDL | LOCAL tipo IDENTIFICADOR Arreglo ENDL | LOCAL tipo IDENTIFICADOR Arreglo ASIGNAR BloqueArreglo ENDL;

asignacion ::= IDENTIFICADOR ASIGNAR expr ENDL ;

//revisar esta parte 
sentencia ::= creacion
            | asignacion
            | expr ENDL
            | DECIDE OF condiciones else_opcional END DECIDE ENDL
            | LOOP sentencias EXIT WHEN expr ENDL END LOOP ENDL
            | FOR PARENTESIS_A asignacion expr ENDL expr PARENTESIS_B bloque
            | RETURN expr ENDL
            | BREAK ENDL
            | SHOW expr ENDL
            | GET expr ENDL
            ;

//para poder tener varias condiciones completas
condiciones ::= condicion | condiciones condicion ;

condicion ::= expr FLECHA bloque ;

//se pide el else opcional, por lo que se pone /* vacio */
else_opcional ::= /* vacio */| ELSE FLECHA bloque ;

sentencias ::=  /* vacio */| sentencias sentencia ;

bloque ::= BLOQUE_A sentencias BLOQUE_C ;

expr ::= expr:a SUMA expr:b             {: Nodo arbol=new Nodo("+"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a RESTA expr:b            {: Nodo arbol=new Nodo("-"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a MULTIPLICACION expr:b   {: Nodo arbol=new Nodo("*"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a DIVISION expr:b         {: Nodo arbol=new Nodo("/"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a DIVISION_ENTERA expr:b  {: Nodo arbol=new Nodo("//"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a MODULO expr:b           {: Nodo arbol=new Nodo("%"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a POTENCIA expr:b         {: Nodo arbol=new Nodo("^"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a MAYOR expr:b            {: Nodo arbol=new Nodo(">"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a MENOR expr:b            {: Nodo arbol=new Nodo("<"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a IGUAL expr:b            {: Nodo arbol=new Nodo("=="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a DIFERENTE expr:b        {: Nodo arbol=new Nodo("!="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a MAYOR_IGUAL expr:b      {: Nodo arbol=new Nodo(">="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a MENOR_IGUAL expr:b      {: Nodo arbol=new Nodo("<="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a AND expr:b              {: Nodo arbol=new Nodo("@"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | expr:a OR expr:b               {: Nodo arbol=new Nodo("~"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; :}
       | NOT expr:a                     {: Nodo arbol= new Nodo("Σ"); arbol.addHijo(a);RESULT=arbol; :}
       | AUMENTO IDENTIFICADOR:idToken {: Nodo arbol = new Nodo("++");
                                           Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
                                           tab.use(idToken.toString(), sid);
                                           arbol.addHijo(new Nodo(idToken.toString()));
                                           RESULT = arbol;:}
       | DISMINUCION IDENTIFICADOR:idToken {: Nodo arbol = new Nodo("--");
                                           Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
                                           tab.use(idToken.toString(), sid);
                                           arbol.addHijo(new Nodo(idToken.toString()));
                                           RESULT = arbol;:}

       | PARENTESIS_A expr:a PARENTESIS_B {: Nodo arbol = new Nodo("¿?"); arbol.addHijo(a); RESULT = arbol;:}
       | literal:l                      {:  RESULT = l; :}
       | IDENTIFICADOR:idToken          {: Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken); tab.use(idTok.toString(), sid); RESULT = new Nodo(idTok.toString());:}      
       ;

Arreglo ::=LLAVE_A INT_LITERAL LLAVE_B LLAVE_A INT_LITERAL LLAVE_B ;
BloqueArreglo ::= BLOQUE_A Columnas BLOQUE_C;
Columnas ::= Columnas COMA filas | filas ;
filas ::= BLOQUE_A L_elementos BLOQUE_C ;
L_elementos ::= L_elementos COMA literal | literal;
