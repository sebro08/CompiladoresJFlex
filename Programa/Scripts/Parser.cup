import java_cup.runtime.*;
import java.util.*;

action code {:
    TablaSimbolos tab = new TablaSimbolos();
:}

parser code {:
    int errores = 0;
    //funcion que cuneta los mensajes error y mustra su poscion
    public void syntax_error(Symbol s){
        errores++;
        System.out.println("Error de sintaxis: "+ s.value +" Línea "+(s.left)+" Columna "+(s.right) );

    }
    //funcion que activa el modo panico y evita que el el cup continue en el siguiente token
    public void unrecovered_syntax_error(Symbol s) throws Exception {
        Symbol t = getScanner().next_token();
    }
    // permite mostar un mensajen que indica si hay errorores que el archivo fuente leido no se puede generar por la gramatica 
     @Override
    public Symbol parse() throws Exception {
        try {
            return super.parse();
        } finally {
            if (errores > 0) {
                System.out.println("\nEl archivo fuente no se puede generar: tiene " + errores + " error sintáctico.");
            }
        }
    }
:}

scan with {:
  return getScanner().next_token();
:};

/* ===== terminales ===== */
terminal SUMA;
terminal RESTA;
terminal MULTIPLICACION;
terminal DIVISION;
terminal DIVISION_ENTERA;
terminal MODULO;
terminal POTENCIA;
terminal AUMENTO;
terminal DISMINUCION;
terminal BLOQUE_A;
terminal BLOQUE_C;
terminal PARENTESIS_A;
terminal PARENTESIS_B;
terminal LLAVE_B;
terminal LLAVE_A;
terminal COMA;
terminal FLECHA;
terminal ASIGNAR;
terminal MAYOR;
terminal MENOR;
terminal IGUAL;
terminal DIFERENTE;
terminal MAYOR_IGUAL;
terminal MENOR_IGUAL;   
terminal AND;
terminal OR;
terminal NOT;
terminal WORD;
terminal LOCAL;
terminal GIFT;
terminal NAVIDAD;
terminal COAL;
terminal INT;
terminal FLOAT;
terminal BOOLEAN;
terminal CHAR;
terminal STRING;
terminal DECIDE;
terminal OF;
terminal ELSE;
terminal END;
terminal LOOP;
terminal EXIT;
terminal WHEN;
terminal FOR;
terminal RETURN;
terminal BREAK;
terminal SHOW;
terminal GET;
terminal ENDL;
terminal INT_LITERAL;
terminal FLOAT_LITERAL;
terminal STRING_LITERAL;
terminal CHAR_LITERAL;
terminal BOOLEAN_LITERAL;
terminal IDENTIFICADOR;


/* ===== No terminales ===== */
non terminal Nodo programa;
non terminal Nodo funciones;
non terminal Nodo globales;
non terminal Nodo global;
non terminal Nodo main;
non terminal Nodo funcion;
non terminal Nodo params;
non terminal Nodo tipo;
non terminal Nodo literal;
non terminal Nodo creacion;
non terminal Nodo asignacion;
non terminal Nodo sentencia;
non terminal Nodo condiciones;
non terminal Nodo condicion;
non terminal Nodo else_opcional;
non terminal Nodo sentencias;
non terminal Nodo bloque;
non terminal Nodo expr;
non terminal Nodo Arreglo;
non terminal Nodo BloqueArreglo;
non terminal Nodo itemParams;
non terminal Nodo Columnas;
non terminal Nodo filas;
non terminal Nodo L_elementos;
non terminal Nodo inicio;
non terminal Nodo llamada;
non terminal Nodo Parametros_LLamada;
non terminal Nodo para_llamada;
non terminal Nodo Aceder_arry;
non terminal Nodo modificar_arry;

/* ===== Precedencias ===== */
precedence left OR;
precedence left AND;
precedence nonassoc MAYOR, MENOR, IGUAL, DIFERENTE, MAYOR_IGUAL, MENOR_IGUAL;
precedence left SUMA, RESTA;
precedence left MULTIPLICACION;
precedence left DIVISION;
precedence left DIVISION_ENTERA;
precedence left MODULO;
precedence right POTENCIA;


start with inicio;

// inicia el programa creando los nodos y cuando termine de crear imprime la tabla de signos 
inicio ::= programa:p {:
    RESULT = p;
    if (errores <= 0){
        //System.out.println(" Tabla de simbolos global ");
        tab.printGlobalTable();
        //System.out.println("\n\n Arbol sintactico:");
        //((Nodo)p).arbol();
    };
:};

programa ::= globales:g funciones:f main:m {:
    Nodo arbol = new Nodo("PROGRAMA");
    arbol.addHijo(g);
    arbol.addHijo(f);
    arbol.addHijo(m);
    RESULT = arbol;
:};

globales ::= globales:gs global:gl {:
    Nodo arbol = gs;
    arbol.addHijo(gl);
    RESULT = arbol;
:}
| /* vacio */
{:
    RESULT = new Nodo("GLOBALES");
:};

global ::= WORD tipo:t IDENTIFICADOR:idToken ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "global", sid);
    Nodo arbol = new Nodo("GLOBAL");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    RESULT = arbol;
:}
| WORD tipo:t IDENTIFICADOR:idToken ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "global", sid);
    String tipoA = e.getTipo();
    String tipoB = t.getTipo();

    Nodo arbol = new Nodo("GLOBAL_ASIG");
    Nodo nid = new Nodo(idToken.toString());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(e);

    
   if (tipoA.equals("error") || tipoB.equals("error")) {
        arbol.setTipo("error");
    }
    else if (!(tipoB.equals(tipoA) || (tipoB.equals("float") && tipoA.equals("int")))) {
        System.err.println("Error semantico en la linea "+ sid.left + ":" + idToken.toString() + " es de tipo " + tipoB + " y se le asigno un "+ tipoA);
        nid.setTipo("error");
    }
    else {
        nid.setTipo(t.getTipo());
    }

    RESULT = arbol;
:}
| WORD tipo:t IDENTIFICADOR:idToken Arreglo:arr ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "global", sid);
    Nodo arbol = new Nodo("GLOBAL_ARREGLO");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(arr);
    RESULT = arbol;
:}
| WORD tipo:t IDENTIFICADOR:idToken Arreglo:arr ASIGNAR BloqueArreglo:blo ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "global", sid);
    Nodo arbol = new Nodo("GLOBAL_ARREGLO_ASIG");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(arr);
    arbol.addHijo(blo);
    RESULT = arbol;
:};

funciones ::= funciones:fs funcion:f {:
    Nodo arbol = fs;
    arbol.addHijo(f);
    RESULT = arbol;
:}
| /* vacio */
{:
    RESULT = new Nodo("FUNCIONES");
:};

funcion ::= GIFT tipo:t IDENTIFICADOR:idToken {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "funcion", sid);
    tab.openScope("Funcion " + idToken.toString());
:}
params:p
bloque:b
{:
    tab.closeScope();
    Nodo arbol = new Nodo("FUNCION");
    arbol.setTipo(t.getTipo());
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(p);
    arbol.addHijo(b);
    RESULT = arbol;
:};

main ::= COAL NAVIDAD PARENTESIS_A PARENTESIS_B
{: tab.openScope("Main"); :}
bloque:b
{:
    tab.closeScope();
    Nodo arbol = new Nodo("MAIN");
    arbol.addHijo(b);
    RESULT = arbol;
:};

params ::= PARENTESIS_A PARENTESIS_B {:
    Nodo arbol = new Nodo("params");
    arbol.addHijo(new Nodo("¿"));
    arbol.addHijo(new Nodo("?"));
    RESULT = arbol;
:}
| PARENTESIS_A itemParams:it PARENTESIS_B {:
    Nodo arbol = new Nodo("params");
    arbol.addHijo(new Nodo("¿"));
    arbol.addHijo(it);
    arbol.addHijo(new Nodo("?"));
    RESULT = arbol;
:};

itemParams ::= tipo:t IDENTIFICADOR:idToken {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "parametro", sid);
    Nodo arbol = new Nodo("itemParams");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    RESULT = arbol;
:}
| itemParams:it COMA tipo:t IDENTIFICADOR:idToken {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "parametro", sid);
    Nodo arbol = new Nodo("itemParams");
    arbol.addHijo(it);
    arbol.addHijo(new Nodo(","));
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    RESULT = arbol;
:};

tipo ::= INT  {: Nodo result = new Nodo("int");     result.setTipo("int");     RESULT=result; :}
    | FLOAT   {: Nodo result = new Nodo("float");   result.setTipo("float");   RESULT=result; :}
    | STRING  {: Nodo result = new Nodo("string");  result.setTipo("string");  RESULT=result; :}
    | BOOLEAN {: Nodo result = new Nodo("boolean"); result.setTipo("boolean"); RESULT=result; :}
    | CHAR    {: Nodo result = new Nodo("char");    result.setTipo("char");    RESULT=result; :}
;

literal ::= INT_LITERAL:result      {: RESULT = new Nodo(result.toString()); RESULT.setTipo("int");:}
    | FLOAT_LITERAL:result          {: RESULT = new Nodo(result.toString()); RESULT.setTipo("float");:}
    | STRING_LITERAL:result         {: RESULT = new Nodo(result.toString()); RESULT.setTipo("string");:}
    | CHAR_LITERAL:result           {: RESULT = new Nodo(result.toString()); RESULT.setTipo("char");:}
    | BOOLEAN_LITERAL:result        {: RESULT = new Nodo(result.toString()); RESULT.setTipo("boolean");:}
;

creacion ::= LOCAL tipo:t IDENTIFICADOR:idToken ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "local", sid);
    Nodo arbol = new Nodo("DECL_LOCAL");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    RESULT = arbol;

:}
| LOCAL tipo:t IDENTIFICADOR:idToken ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "local", sid);
    String tipoA = e.getTipo();
    String tipoB = t.getTipo();

    Nodo arbol = new Nodo("DECL_LOCAL_ASIG");
    Nodo nid = new Nodo(idToken.toString());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(e);

    
   if (tipoA.equals("error") || tipoB.equals("error")) {
        arbol.setTipo("error");
    }
    else if (!(tipoB.equals(tipoA) || (tipoB.equals("float") && tipoA.equals("int")))) {
        System.err.println("Error semantico en la linea "+ sid.left + ":" + idToken.toString() + " es de tipo " + tipoB + " y se le asigno un "+ tipoA);
        nid.setTipo("error");
    }
    else {
        nid.setTipo(t.getTipo());
    }

    RESULT = arbol;
:}
| LOCAL tipo:t IDENTIFICADOR:idToken Arreglo:arr ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "local", sid);
    Nodo arbol = new Nodo("DECL_LOCAL_ARREGLO");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(arr);
    RESULT = arbol;
:}
| LOCAL tipo:t IDENTIFICADOR:idToken Arreglo:arr ASIGNAR BloqueArreglo:blo ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.declare(idToken.toString(), t.getTipo(), "local", sid);
    Nodo arbol = new Nodo("DECL_LOCAL_ARREGLO_ASIG");
    Nodo nid = new Nodo(idToken.toString());
    nid.setTipo(t.getTipo());
    arbol.addHijo(t);
    arbol.addHijo(nid);
    arbol.addHijo(arr);
    arbol.addHijo(blo);
    RESULT = arbol;
:};

asignacion ::= IDENTIFICADOR:idToken ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("ASIGNACION");
    arbol.addHijo(new Nodo(idToken.toString()));
    arbol.addHijo(e);
    RESULT = arbol;
:};

llamada ::= IDENTIFICADOR:idToken PARENTESIS_A Parametros_LLamada:a PARENTESIS_B {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);

    TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());

    Nodo arbol = new Nodo("llamada");

    Nodo idN = new Nodo(idToken.toString());
    if (info != null) {
        idN.setTipo(info.tipo);
    }
    else {
        idN.setTipo("error");
    }

    arbol.addHijo(idN);
    arbol.addHijo(a);

    if (info != null) {
        if (!"funcion".equals(info.categoria)) {
            System.err.println(
                "Error Semantico en la linea "+ sid.left + ": "+ idToken.toString() + " no es una función");
            arbol.setTipo("error");
        } else {
            arbol.setTipo(info.tipo);
        }
    } else {
        arbol.setTipo("error");
    }


    RESULT = arbol;
:};
Parametros_LLamada ::= /* vacio */ {: 
        RESULT = new Nodo("argumentos_vacio");  
    :}
    | para_llamada:a {: 
        RESULT = a; 
    :}
;


para_llamada ::= expr:e {:
    Nodo arbol = new Nodo("argumentos");
    arbol.addHijo(e);
    RESULT = arbol;
:}
| para_llamada:para COMA expr:e {:
    Nodo arbol = para;
    arbol.addHijo(new Nodo(","));
    arbol.addHijo(e);
    RESULT = arbol;
:};



sentencia ::= creacion:c            {:  RESULT = c; :}
            | asignacion:a          {:  RESULT = a; :}
            | expr:e ENDL           {:  RESULT = e; :}
            | DECIDE OF condiciones:cnds else_opcional:els END DECIDE ENDL  {:  Nodo arbol = new Nodo("DECIDE");
                                                                                arbol.addHijo(cnds);
                                                                                if (els != null) arbol.addHijo(els);
                                                                                RESULT = arbol;:}
            | LOOP sentencias:s EXIT WHEN expr:e ENDL END LOOP ENDL          {:  Nodo arbol = new Nodo("LOOP");
                                                                                arbol.addHijo(s);
                                                                                Nodo exitWhen = new Nodo("EXIT_WHEN");
                                                                                exitWhen.addHijo(e);
                                                                                arbol.addHijo(exitWhen);
                                                                                RESULT = arbol;:}
            | FOR PARENTESIS_A asignacion:a expr:cond ENDL expr:inc PARENTESIS_B bloque:b   {:  Nodo arbol = new Nodo("FOR");
                                                                                                    arbol.addHijo(a);
                                                                                                    arbol.addHijo(cond);
                                                                                                    arbol.addHijo(inc);
                                                                                                    arbol.addHijo(b);
                                                                                                    RESULT = arbol;:}
            | FOR PARENTESIS_A creacion:c expr:cond ENDL expr:inc PARENTESIS_B bloque:b   {:  Nodo arbol = new Nodo("FOR");
                                                                                                    arbol.addHijo(c);
                                                                                                    arbol.addHijo(cond);
                                                                                                    arbol.addHijo(inc);
                                                                                                    arbol.addHijo(b);
                                                                                                    RESULT = arbol;:}
            | RETURN expr:e ENDL    {:  Nodo arbol = new Nodo("RETURN");
                                        arbol.addHijo(e);
                                        RESULT = arbol;:}
            | BREAK ENDL            {:  RESULT = new Nodo("BREAK");:}
            | SHOW expr:e ENDL      {:  Nodo arbol = new Nodo("SHOW");
                                        arbol.addHijo(e);
                                        RESULT = arbol;:}
            | GET expr:e ENDL       {:  Nodo arbol = new Nodo("GET");
                                        arbol.addHijo(e);
                                        RESULT = arbol;:}
            | error ENDL            {:  RESULT = new Nodo("ERROR_STMT");:}
            | modificar_arry:ma {: RESULT = ma; :}
            ;

//para poder tener varias condiciones completas
condiciones ::= condicion:con {:Nodo arbol = con;RESULT = arbol;:}   
                | condiciones:cons condicion:con {: Nodo arbol = cons; arbol.addHijo(con); RESULT = arbol; :};

condicion ::= expr:exp FLECHA bloque:blo {:
    Nodo arbol = new Nodo("condicion");
    arbol.addHijo(exp);
    arbol.addHijo(new Nodo("->"));
    arbol.addHijo(blo);
    RESULT = arbol;
:}
;

//se pide el else opcional, por lo que se pone /* vacio */
else_opcional ::= /* vacio */| ELSE FLECHA bloque:blo {:
    Nodo arbol = new Nodo("ELSE");
    arbol.addHijo(new Nodo("->"));
    arbol.addHijo(blo);
    RESULT = arbol;
:}
;

sentencias ::= /* vacio */ {:
    RESULT = new Nodo("SENTENCIAS");
:}
| sentencias:ss sentencia:st {:
    Nodo arbol = ss;
    if (st == null) st = new Nodo("SENTENCIA_NULL");
    arbol.addHijo(st);
    RESULT = arbol;
:};

bloque ::= BLOQUE_A sentencias:s BLOQUE_C {:
    Nodo arbol = new Nodo("BLOQUE");
    arbol.addHijo(s);
    RESULT = arbol;
:};


expr ::= expr:a SUMA expr:b             {: Nodo arbol=new Nodo("+"); arbol.addHijo(a); arbol.addHijo(b);
    String tipoA = a.getTipo();
    String tipoB = b.getTipo();

    boolean numA = tipoA.equals("int") || tipoA.equals("float");
    boolean numB = tipoB.equals("int") || tipoB.equals("float");

   if (tipoA.equals("error") || tipoB.equals("error")) {
        arbol.setTipo("error");
    }
    else if   (!numA || !numB) {
        System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " + " + b.getTipo() + ")");
        arbol.setTipo("error");
    }
    else {
        System.out.println("funciono");
        if (tipoA.equals("float") || tipoB.equals("float")) {
            arbol.setTipo("float");
        }
        else{
            arbol.setTipo("int");
        }
    }
    RESULT = arbol;
:}
       | expr:a RESTA expr:b            {: Nodo arbol=new Nodo("-"); arbol.addHijo(a); arbol.addHijo(b); 
    String tipoA = a.getTipo();
    String tipoB = b.getTipo();

    boolean numA = tipoA.equals("int") || tipoA.equals("float");
    boolean numB = tipoB.equals("int") || tipoB.equals("float");

    if (tipoA.equals("error") || tipoB.equals("error")) {
        arbol.setTipo("error");
    }
    else if   (!numA || !numB) {
    System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " - " + b.getTipo() + ")");
    arbol.setTipo("error");
    }
    else {
        System.out.println("funciono");
        if (tipoA.equals("float") || tipoB.equals("float")) {
            arbol.setTipo("float");
        }
        else{
            arbol.setTipo("int");
        }
    }

    RESULT = arbol;:}
       | expr:a MULTIPLICACION expr:b   {: Nodo arbol=new Nodo("*"); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");

        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " * " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            if (tipoA.equals("float") || tipoB.equals("float")) {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a DIVISION expr:b         {: Nodo arbol=new Nodo("/"); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if   (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " / " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            if (tipoA.equals("float") || tipoB.equals("float")) {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}

       | expr:a DIVISION_ENTERA expr:b  {: Nodo arbol=new Nodo("//"); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " // " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            if (tipoA.equals("float") || tipoB.equals("float")) {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a MODULO expr:b           {: Nodo arbol=new Nodo("%"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " % " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            if (tipoA.equals("float") || tipoB.equals("float")) {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a POTENCIA expr:b         {: Nodo arbol=new Nodo("^"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol;
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if   (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " ^ " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            if (tipoA.equals("float") || tipoB.equals("float")) {
                arbol.setTipo("float");
            }
            else{
                arbol.setTipo("int");
            }
        }

        RESULT = arbol;:}
       | expr:a MAYOR expr:b            {: Nodo arbol=new Nodo(">"); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " > " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a MENOR expr:b            {: Nodo arbol=new Nodo("<"); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " < " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a IGUAL expr:b            {: Nodo arbol=new Nodo("=="); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if (tipoA != tipoB) {
            System.out.println(
                "Error Semantico en la linea " + aleft +": comparación con tipos incompatibles (" + tipoA + " == " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT = arbol;:}
    
       | expr:a DIFERENTE expr:b        {: Nodo arbol=new Nodo("!="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol;
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if (tipoA != tipoB) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": comparación con tipos incompatibles (" +
                tipoA + " != " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT = arbol;:}
       | expr:a MAYOR_IGUAL expr:b      {: Nodo arbol=new Nodo(">="); arbol.addHijo(a); arbol.addHijo(b); RESULT=arbol; 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " >= " + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a MENOR_IGUAL expr:b      {: Nodo arbol=new Nodo("<="); arbol.addHijo(a); arbol.addHijo(b);
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();

        boolean numA = tipoA.equals("int") || tipoA.equals("float");
        boolean numB = tipoB.equals("int") || tipoB.equals("float");
        
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if  (!numA || !numB) {
            System.out.println("Error Semantico en la linea "+ aleft + ": tipos incompatibles (" + a.getTipo() + " <=" + b.getTipo() + ")");
            arbol.setTipo("error");
        }
        else {
            System.out.println("funciono");
            arbol.setTipo("boolean");
        }

        RESULT = arbol;:}
       | expr:a AND expr:b              {: Nodo arbol=new Nodo("@"); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if (!tipoA.equals("boolean") || !tipoB.equals("boolean")) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": AND utiliza boolean (" + tipoA + " @ " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT=arbol; :}
       | expr:a OR expr:b               {: Nodo arbol=new Nodo("~"); arbol.addHijo(a); arbol.addHijo(b); 
        String tipoA = a.getTipo();
        String tipoB = b.getTipo();
        if (tipoA.equals("error") || tipoB.equals("error")) {
            arbol.setTipo("error");
        }
        else if (!tipoA.equals("boolean") || !tipoB.equals("boolean")) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": OR utiliza boolean (" + tipoA + " ~ " + tipoB + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT=arbol; :}
       | NOT expr:a                     {: Nodo arbol= new Nodo("Σ"); arbol.addHijo(a);
        String tipoA = a.getTipo();
        if (tipoA.equals("error") ) {
            arbol.setTipo("error");
        }
        else if (!tipoA.equals("boolean")) {
            System.out.println(
                "Error Semantico en la linea " + aleft +
                ": Not utiliza boolean (  Σ " + tipoA + ")"
            );
            arbol.setTipo("error");
        }
        else {
            arbol.setTipo("boolean");
        }
        RESULT=arbol; :}
       | AUMENTO IDENTIFICADOR:idToken {: Nodo arbol = new Nodo("++");
                                            Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
                                            tab.use(idToken.toString(), sid);
                                            Nodo idN = new Nodo(idToken.toString());
                                            TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
                                            if (info != null) {
                                                idN.setTipo(info.tipo);
                                                if (!info.tipo.equals("int") && !info.tipo.equals("float")) {
                                                    System.err.println(
                                                        "Error semántico: '++' solo se permite en int/float, pero '" +idToken.toString() + "' es " + info.tipo );
                                                    arbol.setTipo("error");
                                                } else {
                                                    arbol.setTipo(info.tipo);
                                                }
                                            } else {
                                                idN.setTipo("error");
                                                arbol.setTipo("error");
                                            }

                                            arbol.addHijo(idN);
                                           RESULT = arbol;:}
       | DISMINUCION IDENTIFICADOR:idToken {: Nodo arbol = new Nodo("--");

                                            Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
                                            tab.use(idToken.toString(), sid);
                                            Nodo idN = new Nodo(idToken.toString());
                                            TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
                                            if (info != null) {
                                                idN.setTipo(info.tipo);
                                                if (!info.tipo.equals("int") && !info.tipo.equals("float")) {
                                                    System.err.println("Error semántico: '--' solo se permite en int/float, pero '" +idToken.toString() + "' es " + info.tipo );
                                                    arbol.setTipo("error");
                                                } else {
                                                    arbol.setTipo(info.tipo);
                                                }
                                            } else {
                                                idN.setTipo("error");
                                                arbol.setTipo("error");
                                            }
                                            arbol.addHijo(idN);
                                            RESULT = arbol;:}

       | PARENTESIS_A expr:a PARENTESIS_B {: Nodo arbol = new Nodo("¿?"); arbol.addHijo(a); arbol.setTipo(a.getTipo()); RESULT = arbol; :}
       | literal:l                      {:  RESULT = l; :}
       | IDENTIFICADOR:idToken          {: Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken); tab.use(idToken.toString(), sid); 
        Nodo arbol = new Nodo(idToken.toString());
        TablaSimbolos.SymbolInfo info = tab.lookup(idToken.toString());
        if (info != null){
            arbol.setTipo(info.tipo);
        } 
        else {
            
            arbol.setTipo("error");  
        } 
        RESULT = arbol;
       :}  
       | llamada:call                   {:  RESULT = call; :} 
       | Aceder_arry:aa {: RESULT = aa; :}   
       ;
Arreglo ::=LLAVE_A INT_LITERAL:a LLAVE_B LLAVE_A INT_LITERAL:b LLAVE_B {:
    Nodo arbol = new Nodo("arreglo");
    arbol.addHijo(new Nodo("[]"));
    arbol.addHijo(new Nodo(a.toString()));
    arbol.addHijo(new Nodo("[]"));
    arbol.addHijo(new Nodo(b.toString()));
    RESULT = arbol;
:};

Aceder_arry ::= IDENTIFICADOR:idToken LLAVE_A expr:i LLAVE_B {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("Filas");
    arbol.addHijo(new Nodo(idToken.toString()));
    Nodo a = new Nodo("[]");
    a.addHijo(i);
    arbol.addHijo(a);
    RESULT = arbol;:}
    | IDENTIFICADOR:idToken LLAVE_A expr:i LLAVE_B LLAVE_A expr:j LLAVE_B {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("Filas Columnas");
    arbol.addHijo(new Nodo(idToken.toString()));
    Nodo a = new Nodo("[]");
    a.addHijo(i);
    Nodo b = new Nodo("[]");
    b.addHijo(j);
    arbol.addHijo(a);
    arbol.addHijo(a);
    RESULT = arbol;
:};
modificar_arry ::= IDENTIFICADOR:idToken LLAVE_A expr:i LLAVE_B ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("filas");
    arbol.addHijo(new Nodo(idToken.toString()));
    Nodo a = new Nodo("[]");
    a.addHijo(i);
    arbol.addHijo(a);

    arbol.addHijo(e);
    RESULT = arbol;
:}
| IDENTIFICADOR:idToken LLAVE_A expr:i LLAVE_B LLAVE_A expr:j LLAVE_B ASIGNAR expr:e ENDL {:
    Symbol sid = new Symbol(sym.IDENTIFICADOR, idTokenleft, idTokenright, idToken);
    tab.use(idToken.toString(), sid);
    Nodo arbol = new Nodo("filas columnas");
    arbol.addHijo(new Nodo(idToken.toString()));
    Nodo a = new Nodo("[]");
    a.addHijo(i);
    Nodo b = new Nodo("[]");
    b.addHijo(j);
    arbol.addHijo(a);
    arbol.addHijo(b);
    arbol.addHijo(e);
    RESULT = arbol;
:};

BloqueArreglo ::= BLOQUE_A Columnas:col BLOQUE_C {:
    Nodo arbol = new Nodo("BloqueArreglo");
    arbol.addHijo(new Nodo("¡!"));
    arbol.addHijo(col);
    RESULT = arbol;
:};

Columnas ::= Columnas:col COMA filas:fil {:Nodo arbol = col;arbol.addHijo(new Nodo(","));arbol.addHijo(fil);RESULT = arbol;:}
            | filas:fil {:Nodo arbol = new Nodo("Columnas");arbol.addHijo(new Nodo("¡!"));arbol.addHijo(fil);RESULT = arbol;:};

filas ::= BLOQUE_A L_elementos:lista BLOQUE_C {:

    Nodo arbol = new Nodo("fila");
    arbol.addHijo(new Nodo("¡!"));
    arbol.addHijo(lista);
    RESULT = arbol;
:};

L_elementos ::= L_elementos:lista COMA literal:li {:Nodo arbol = lista; arbol.addHijo(new Nodo(","));arbol.addHijo(li);RESULT = arbol;:}        
            | literal:li {:Nodo arbol = new Nodo("elementos");arbol.addHijo(li); RESULT = arbol;:};
