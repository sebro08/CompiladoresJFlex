import java_cup.runtime.*;
import java.util.*;

action code {:
    //TablaSimbolos tab = new TablaSimbolos();
    String tipoF = "";
:}

parser code {:
    int errores = 0;

    public Nodo raiz;
    public TablaSimbolos tab = new TablaSimbolos();

    // Getters para acceder desde Main
    public Nodo getRaiz() {
        return raiz;
    }

    public TablaSimbolos getTablaSimbolos() {
        return tab;
    }

    //funcion que cuneta los mensajes error y mustra su poscion
    public void syntax_error(Symbol s){
        errores++;
        System.out.println("Error de sintaxis: "+ s.value +" Línea "+(s.left)+" Columna "+(s.right) );

    }
    //funcion que activa el modo panico y evita que el el cup continue en el siguiente token
    public void unrecovered_syntax_error(Symbol s) throws Exception {
        Symbol t = getScanner().next_token();
    }
    // permite mostar un mensajen que indica si hay errorores que el archivo fuente leido no se puede generar por la gramatica 
     @Override
    public Symbol parse() throws Exception {
        try {
            return super.parse();
        } finally {
            if (errores > 0) {
                System.out.println("\nEl archivo fuente no se puede generar: tiene " + errores + " error sintáctico.");
            }
        }
    }
:}

scan with {:
  return getScanner().next_token();
:};

/* ===== terminales ===== */
terminal SUMA;
terminal RESTA;
terminal MULTIPLICACION;
terminal DIVISION;
terminal DIVISION_ENTERA;
terminal MODULO;
terminal POTENCIA;
terminal AUMENTO;
terminal DISMINUCION;
terminal BLOQUE_A;
terminal BLOQUE_C;
terminal PARENTESIS_A;
terminal PARENTESIS_B;
terminal LLAVE_B;
terminal LLAVE_A;
terminal COMA;
terminal FLECHA;
terminal ASIGNAR;
terminal MAYOR;
terminal MENOR;
terminal IGUAL;
terminal DIFERENTE;
terminal MAYOR_IGUAL;
terminal MENOR_IGUAL;   
terminal AND;
terminal OR;
terminal NOT;
terminal WORD;
terminal LOCAL;
terminal GIFT;
terminal NAVIDAD;
terminal COAL;
terminal INT;
terminal FLOAT;
terminal BOOLEAN;
terminal CHAR;
terminal STRING;
terminal DECIDE;
terminal OF;
terminal ELSE;
terminal END;
terminal LOOP;
terminal EXIT;
terminal WHEN;
terminal FOR;
terminal RETURN;
terminal BREAK;
terminal SHOW;
terminal GET;
terminal ENDL;
terminal INT_LITERAL;
terminal FLOAT_LITERAL;
terminal STRING_LITERAL;
terminal CHAR_LITERAL;
terminal BOOLEAN_LITERAL;
terminal IDENTIFICADOR;


/* ===== No terminales ===== */
non terminal Nodo programa;
non terminal Nodo funciones;
non terminal Nodo globales;
non terminal Nodo global;
